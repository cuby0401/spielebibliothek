# Kopie als .env neben compose.yaml auf der NAS anlegen. .env NIE ins Git.

# Wo Spiele und Datenbanken liegen (leer = Pfade der NAS). Auf der Docker-VM:
#   SPIELE_DIR=/mnt/nas/games/spiele                              (SMB-Freigabe der NAS)
#   DATEN_DIR=/opt/stacks/spielebibliothek-daten/data             (lokale Platte – Datenbanken nie auf einer Freigabe)
#   UPLOAD_DATEN_DIR=/opt/stacks/spielebibliothek-daten/upload    (lokale Platte)
SPIELE_DIR=
DATEN_DIR=
UPLOAD_DATEN_DIR=

# Token des Cloudflare-Tunnels "spielebibliothek"
TUNNEL_TOKEN=

# Einladungsmails aus dem CRM (Zentrale 1.4.0) – vorhandenes Postfach. Leer lassen = Versand aus.
# SMTP_VERSCHLUESSELUNG: starttls (Port 587) oder ssl (Port 465). Klartext gibt es nicht.
SMTP_HOST=
SMTP_PORT=
SMTP_VERSCHLUESSELUNG=starttls
SMTP_BENUTZER=
SMTP_PASSWORT=
SMTP_ABSENDER=

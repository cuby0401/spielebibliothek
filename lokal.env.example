# Adressen der eigenen Server – als lokal.env in den Repo-Wurzelordner kopieren und ausfüllen. lokal.env steht in .gitignore.
# Gelesen von scripts/lokal.sh (Shell) und scripts/cloudflare.py / scripts/auftraege-mac.py. Umgebungsvariablen gehen vor.
# Format: NAME=wert, ohne Leerzeichen und Anführungszeichen.

# Wo die Zentrale läuft: nas oder vm. deploy.sh, e2e-alle.sh, die Einrichtungsskripte, cloudflare.py und auftraege-mac.py
# gehen alle dorthin. Die Pfade je Ort stehen in scripts/lokal.sh.
SERVER_ORT=vm

# --- NAS (UGOS) ---
# ssh-Ziel (Benutzer@Host)
NAS=benutzer@nas.beispiel.ts.net
# Drei verschiedene Namen derselben NAS, damit games, play und upload im Teststand getrennte Origins und Cookies haben:
# Tailscale-Name, Tailscale-IP, Kurzname. Nur für Ende-zu-Ende-Tests auf der NAS und die Design-Spielwiese.
NAS_GH=nas.beispiel.ts.net
NAS_PH=100.64.0.1
NAS_UH=nas
# LAN-Adresse: Dort lauscht die Probe-Zentrale (Ports 18188–18190), die Tunnel-Routen des Testservers zeigen hierher.
NAS_LAN=192.0.2.10

# --- Docker-VM ---
VM=benutzer@192.0.2.11
VM_LAN=192.0.2.11
# Drei Namen der VM für den Teststand – nur für Ende-zu-Ende-Tests auf der VM, wenn am Mac kein Docker Desktop läuft
VM_GH=192.0.2.11
VM_PH=vm.beispiel.lan
VM_UH=vm

# Spielebibliothek – Caddy
# Spezifikation: seb-brain → Projekte/Spielebibliothek/Architektur/Docker-Compose, Sicherheit/Schutz-vor-Schadcode
#
# Caddy lauscht im Container auf :8080 (läuft als Nicht-root ohne Capabilities).
# TLS macht Cloudflare, deshalb nur HTTP. Alle Hostnamen kommen über denselben Tunnel:
#   games.cuby0401.uk → Bibliotheksseite, /lib, /api
#   play.cuby0401.uk  → nur Spieldateien (/play) und /lib – eigener Origin für die Spiele (E14)
#   upload.cuby0401.uk → Upload-Seite + Upload-Dienst (Phase 6b, ersetzt File Browser – E19)
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	# Für alle Antworten
	header {
		Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# ---------- Not-Aus (1.4.0, Nachtest 08.11.): solange config/notaus.json existiert, gibt es auf KEINER Adresse mehr etwas ----------
	# Auch keine Hilfe, kein Handbuch, keine Spieldateien. Nur /api/* geht weiter an die Dienste – die antworten selbst
	# mit 503 und dem Grund (das Admin-Panel zeigt dann „Not-Aus ist AN“). Caddy darf config/ nur durchqueren (x), nicht lesen.
	@notaus {
		file {
			root /config
			try_files /notaus.json
		}
		not path /api/*
	}
	handle @notaus {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond `<!doctype html><html lang="de"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Spielebibliothek – Not-Aus</title><h1>Not-Aus aktiv</h1><p>Die Spielebibliothek ist vorübergehend abgeschaltet. Bitte später noch einmal versuchen.</p></html>` 503
	}

	# ---------- play.cuby0401.uk: nur Spiele ----------
	@play host play.cuby0401.uk
	handle @play {
		# Anmelde-Sprung: Die Bibliothek schickt den Browser einmal hierher (Access meldet ihn
		# für play an) und bekommt ihn sofort zurück. Ziel bleibt immer auf games.cuby0401.uk.
		handle /__anmelden {
			redir https://games.cuby0401.uk/{query.ziel} 302
		}

		# Die Bibliothek prüft hiermit, ob der Browser für play angemeldet ist
		handle /__status {
			header Access-Control-Allow-Origin "https://games.cuby0401.uk"
			header Access-Control-Allow-Credentials "true"
			respond 204
		}

		handle_path /lib/* {
			header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			root * /srv/lib
			file_server
		}

		# Hochgeladene Spiele – nur lesend, nur erlaubte Dateitypen (Phase 7)
		handle_path /play/* {
			root * /srv/spiele

			# Versteckte Dateien und Ordner (.env, .git, …) nie ausliefern
			@versteckt path_regexp (^|/)\.
			respond @versteckt 404

			# Nur Endungen aus der Whitelist – oder ein Ordner (liefert dessen index.html).
			# Alles andere (.exe .bat .sh .zip .msi .dmg .jar .apk …) gibt es nicht.
			@verboten not path_regexp (?i)(/|\.(html?|m?js|css|json|png|jpe?g|gif|webp|svg|ico|mp3|ogg|wav|m4a|mp4|webm|woff2?|ttf|otf|wasm|txt|glb|gltf|bin))$
			respond @verboten 404

			# Spiele: nur eigene Dateien, keine externen Server (E20), einbettbar nur von der Bibliothek.
			# 'unsafe-inline'/'unsafe-eval': KI-Spiele nutzen fast immer Inline-Scripts, Engines teils eval.
			@kein_svg not path_regexp (?i)\.svg$
			header @kein_svg Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors https://games.cuby0401.uk"

			# SVG kann Skripte enthalten – die laufen hier nie
			@svg path_regexp (?i)\.svg$
			header @svg Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors https://games.cuby0401.uk; sandbox"

			file_server
		}

		handle {
			respond 404
		}
	}

	# ---------- upload.cuby0401.uk: Upload für Entwickler ----------
	@upload host upload.cuby0401.uk
	handle @upload {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

		# Der Upload-Dienst prüft das Access-JWT (eigene AUD) und das Upload-Passwort
		handle /api/upload/* {
			reverse_proxy upload:8000
		}
		handle /style.css {
			root * /srv/site
			file_server
		}
		handle /upload/* {
			root * /srv/site
			file_server
		}
		handle / {
			rewrite * /upload/index.html
			root * /srv/site
			file_server
		}
		handle {
			respond 404
		}
	}

	# ---------- games.cuby0401.uk: Bibliothek ----------

	# Die Bibliothek spricht nur mit sich selbst und mit play; sie lässt sich nirgends einbetten.
	@games not host play.cuby0401.uk upload.cuby0401.uk
	header @games Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://play.cuby0401.uk; frame-src https://play.cuby0401.uk; connect-src 'self' https://play.cuby0401.uk; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	# GameSave-Bibliothek und Bridge
	handle_path /lib/* {
		root * /srv/lib
		file_server
	}

	# Speicher-Dienst. Den Header Cf-Access-Jwt-Assertion setzt Cloudflare Access, Caddy reicht ihn durch.
	handle /api/* {
		reverse_proxy savesvc:8000
	}

	# Spiele gibt es nur unter play.cuby0401.uk (E14), den Upload nur unter upload.cuby0401.uk
	handle /play/* {
		respond 404
	}
	handle /upload/* {
		respond 404
	}

	# Testseite der Bausteine (/ui-test/) nur für die automatischen Tests: live und auf dem Testserver gesperrt.
	# teststand.sh entfernt die mit NUR-LIVE markierten Zeilen für Teststand und Design-Spielwiese.
	handle /ui-test* {   # NUR-LIVE
		respond 404      # NUR-LIVE
	}                    # NUR-LIVE

	# Bibliotheksseite
	handle {
		root * /srv/site
		file_server
	}
}
